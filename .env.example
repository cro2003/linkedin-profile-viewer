# --- app ---
API_KEYS=devkey123,anotherkey
LOG_LEVEL=INFO

# --- infra ---
MONGO_URL=mongodb://mongo:27017
MONGO_DB=linkedin
REDIS_URL=redis://redis:6379

# --- linkedin accounts ---
# JSON list. Harvest li_at + JSESSIONID from a logged-in browser session.
# jsessionid: the raw value including the "ajax:" prefix, no surrounding quotes.
# proxy_url: null or "http://user:pass@host:port". Null/dead proxy falls back to direct.
LINKEDIN_ACCOUNTS=[{"id":"acct1","li_at":"REPLACE","jsessionid":"ajax:REPLACE","proxy_url":null},{"id":"acct2","li_at":"REPLACE","jsessionid":"ajax:REPLACE","proxy_url":null}]

# --- fetch tuning ---
ACCOUNT_MIN_DELAY_SEC=8
ACCOUNT_MAX_DELAY_SEC=20
PROXY_REQUIRED=false
CACHE_TTL_HOURS=24
NEGATIVE_CACHE_TTL_HOURS=1

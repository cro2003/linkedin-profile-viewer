# --- app ---
API_KEYS=devkey123,anotherkey
LOG_LEVEL=INFO

# --- infra ---
MONGO_URL=mongodb://mongo:27017
MONGO_DB=linkedin
REDIS_URL=redis://redis:6379

# --- linkedin accounts ---
# JSON list, one entry per account. `cookies` must be the FULL cookie set harvested
# from a logged-in browser session, not just li_at: LinkedIn's edge requires its
# routing cookies (lidc, bcookie, bscookie) or it 302s to the same URL forever.
# proxy_url: null or "http://user:pass@host:port". A null or dead proxy falls back to direct.
LINKEDIN_ACCOUNTS=[{"id":"acct1","cookies":{"li_at":"REPLACE","JSESSIONID":"ajax:REPLACE","lidc":"REPLACE","bcookie":"REPLACE"},"proxy_url":null}]

# --- fetch tuning ---
ACCOUNT_MIN_DELAY_SEC=8
ACCOUNT_MAX_DELAY_SEC=20
PROXY_REQUIRED=false
CACHE_TTL_HOURS=24
NEGATIVE_CACHE_TTL_HOURS=1

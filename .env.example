# --- app ---
API_KEYS=devkey123,anotherkey
LOG_LEVEL=INFO

# --- infra ---
MONGO_URL=mongodb://mongo:27017
MONGO_DB=linkedin
REDIS_URL=redis://redis:6379

# --- linkedin accounts ---
# JSON list, one entry per account. `cookies` must be the FULL cookie set harvested
# from a logged-in browser session, not just li_at: LinkedIn's edge requires its
# routing cookies (lidc, bcookie, bscookie) or it 302s to the same URL forever.
# proxy_url: null or "http://user:pass@host:port". A null or dead proxy falls back to direct.
# `email`/`password` are OPTIONAL and only used as a last-resort re-login when the
# worker's persisted browser profile cannot refresh the session by itself. Omit them
# to disable scripted login entirely (a scripted login is the most likely thing to
# trigger a security checkpoint).
LINKEDIN_ACCOUNTS=[{"id":"acct1","cookies":{"li_at":"REPLACE","JSESSIONID":"ajax:REPLACE","lidc":"REPLACE","bcookie":"REPLACE"},"proxy_url":null,"email":null,"password":null}]

# --- fetch tuning ---
ACCOUNT_MIN_DELAY_SEC=8
ACCOUNT_MAX_DELAY_SEC=20
PROXY_REQUIRED=false
CACHE_TTL_HOURS=24
NEGATIVE_CACHE_TTL_HOURS=1

# --- inbound limits ---
RATE_LIMIT_WRITE_PER_MIN=10
RATE_LIMIT_READ_PER_MIN=60
# only enable behind a proxy that sets X-Forwarded-For (Traefik); otherwise the
# header is caller-supplied and trivially forged
TRUST_PROXY_HEADERS=false
SSE_MAX_DURATION_SEC=300
